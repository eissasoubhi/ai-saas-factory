# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_saas_factory

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Transactional email (Resend). In development, missing values log email payloads to stdout.
RESEND_API_KEY=
EMAIL_FROM=AI SaaS Factory <onboarding@example.com>

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_API_VERSION=2026-04-22.dahlia

# AI runtime
OPENAI_API_KEY=
AI_DEFAULT_MODEL_ID=openai:gpt-5-mini
AI_ALLOWED_MODEL_IDS=openai:gpt-5-mini
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=20
# Pricing is intentionally deployment-configured instead of hardcoded.
# Example shape: {"openai:model":{"inputUsdPerMillion":1.25,"outputUsdPerMillion":10}}
AI_MODEL_PRICING_JSON={}

# RAG embeddings. The database vector column is deliberately fixed at 1536 dimensions.
AI_EMBEDDING_MODEL_ID=openai:text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_MAX_PARALLEL_CALLS=2
RAG_RETRIEVAL_LIMIT=6
RAG_MIN_SIMILARITY=0.35
RAG_CHUNK_CHARS=3000
RAG_CHUNK_OVERLAP_CHARS=300
DOCUMENT_MAX_PDF_PAGES=200
DOCUMENT_MAX_EXTRACTED_CHARS=2000000
DOCUMENT_EXTRACTION_TIMEOUT_MS=30000

# Backward-compatible fallback used when AI_DEFAULT_MODEL_ID is omitted.
OPENAI_MODEL=gpt-5-mini

# Private S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
# Set a custom S3 endpoint for R2/MinIO. Leave empty for AWS S3.
STORAGE_ENDPOINT=
# Leave credentials empty only when the runtime provides AWS credentials through its normal provider chain.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown,text/csv,application/json

# Durable PostgreSQL jobs (pg-boss)
# Defaults to DATABASE_URL when empty.
JOBS_DATABASE_URL=
JOBS_SCHEMA=pgboss
# Worker startup can migrate the pg-boss schema. Set false when migrations are managed separately.
JOBS_MIGRATE_ON_START=true

# Platform API / outbound webhook secret encryption
# Required by the web app when creating/rotating webhook endpoints and by the worker when delivering them.
# Use one stable 32-byte key encoded as 64 hex characters or base64url. Never commit the real value.
PLATFORM_SECRET_ENCRYPTION_KEY=
