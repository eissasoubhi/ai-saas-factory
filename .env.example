# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_saas_factory

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Transactional email (Resend). In development, missing values log email payloads to stdout.
RESEND_API_KEY=
EMAIL_FROM=AI SaaS Factory <onboarding@example.com>

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_API_VERSION=2026-04-22.dahlia

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini